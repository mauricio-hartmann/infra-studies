POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
CUSTOMERS_DB=InfraStudiesCustomersDB
TICKETS_DB=InfraStudiesTicketsDB

REDIS_USER=admin
REDIS_PASSWORD=admin

ConnectionStrings__PostgresCustomersConnection="Host=postgres;Port=5432;Database=${CUSTOMERS_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
ConnectionStrings__PostgresTicketsConnection="Host=postgres;Port=5432;Database=${TICKETS_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
ConnectionStrings__LogsConnection="Host=postgres;Port=5432;Database=LogsDB;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
ConnectionStrings__RedisConnection="redis:6379,user=${REDIS_USER},password=${REDIS_PASSWORD}"